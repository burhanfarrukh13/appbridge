{
  "name": "appbridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, safety-governed computer use for AI agents: drives any Windows app through accessibility, verifies actions, and gates irreversible effects behind human approval.",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean && node -e \"const fs = require('fs'); fs.globSync('packages/*/dist').forEach(p => fs.rmSync(p, {recursive: true, force: true}))\"",
    "test": "node --test packages/*/dist/*.test.js",
    "lint:universality": "node scripts/universality-lint.mjs",
    "check": "npm run build && npm run test && npm run lint:universality",
    "appbridge": "node packages/cli/dist/index.js",
    "desktop": "cd apps/desktop && flutter run -d windows",
    "desktop:build": "cd apps/desktop && flutter build windows",
    "init": "node packages/cli/dist/index.js init",
    "doctor": "node packages/cli/dist/index.js doctor",
    "verify": "npm run check",
    "repo:set": "node scripts/set-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "license": "Apache-2.0",
  "author": "Burhan Qureshi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/REPO.git"
  },
  "homepage": "https://github.com/OWNER/REPO#readme",
  "bugs": {
    "url": "https://github.com/OWNER/REPO/issues"
  },
  "keywords": [
    "computer-use",
    "desktop-automation",
    "mcp",
    "model-context-protocol",
    "accessibility",
    "ui-automation",
    "ai-agent",
    "windows",
    "safety",
    "approvals"
  ],
  "bin": {
    "appbridge": "packages/cli/dist/index.js"
  }
}
